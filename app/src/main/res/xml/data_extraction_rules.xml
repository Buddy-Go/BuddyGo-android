<?xml version="1.0" encoding="utf-8"?>
<!--
   데이터 추출 규칙 (Android 12 이상). 로그인 토큰이 든 설정 파일(buddygo_session.xml)은
   클라우드 백업과 기기 간 전송에서 모두 뺀다. 나머지(최근 검색 지역 등)는 기본대로 백업된다.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="buddygo_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="buddygo_session.xml" />
    </device-transfer>
</data-extraction-rules>
